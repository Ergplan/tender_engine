FROM node:22-bookworm-slim
WORKDIR /app/web
COPY web/package.json web/package-lock.json ./
# The lockfile's hash beside the modules: `make local` reinstalls only when it changed.
RUN npm ci --no-audit --no-fund && sha256sum package-lock.json > node_modules/.lock-sha \
    && chown -R node:node /app
COPY --chown=node:node web/ ./
USER node
EXPOSE 5173
CMD ["npm", "run", "dev"]
