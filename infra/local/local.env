# Settings for the stack on a developer's machine (`make local`). Checked in: nothing here
# is a secret, and every value works only on localhost. Put your own Anthropic key (and
# anything else you want to change) in .env.local at the repository root, which is
# gitignored and read after this file.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-fable-5-1
DATABASE_URL=postgresql+psycopg://tender_app:tender_app@db:5432/tender
MIGRATION_DATABASE_URL=postgresql+psycopg://tender:tender@db:5432/tender
STORAGE_BACKEND=local
PRODUCT=enterprise
DATA_DIR=/data
TENANT_ID=ergplan
PUBLIC_BASE_URL=http://localhost:8080
# Local-only values: the admin routes and the sign-in state need something set.
ADMIN_TOKEN=local-admin-token-not-for-production
SESSION_SECRET=local-session-secret-not-for-production-0000
TENDERS_ROOT=/work/tenders
# No weekly check of agency sites from a laptop.
FRESHNESS_INTERVAL_DAYS=0
# Docling is off locally (it needs 3 GB); `make local-docling` turns it on.
DOCLING_URL=
# Retrieval with the local ONNX model, downloaded once from Hugging Face into .local/data.
RETRIEVAL_ENABLED=true
EMBEDDINGS_PROVIDER=local
EMBEDDINGS_CACHE_DIR=/data/models/fastembed
# A TenderOS receiver on the same machine or Docker network is allowed locally.
WEBHOOK_ALLOW_PRIVATE=true
HAYSTACK_TELEMETRY_ENABLED=False
FREE_SIGNUP_ENABLED=false
