# Copy to .env and fill in. .env is gitignored; never commit secrets.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-fable-5-1
OPENAI_API_KEY=
# The independent agent pass (Stage 5A): its OpenAI model, the list prices the run's cost
# is figured at (USD per million tokens; the invoice is the truth), the turn limit of one
# pass and the pages one read_pages call may return.
OPENAI_MODEL=gpt-6.1-sol
OPENAI_PRICE_IN_PER_MTOK=2.5
OPENAI_PRICE_OUT_PER_MTOK=10.0
AGENT_MAX_TURNS=200
AGENT_MAX_PAGES_PER_READ=6
# The app connects as `tender_app`, a role without ownership that row-level security binds
# (dev password from infra/db/init.sql); migrations run as the owner `tender`.
DATABASE_URL=postgresql+psycopg://tender_app:tender_app@db:5432/tender
MIGRATION_DATABASE_URL=postgresql+psycopg://tender:tender@db:5432/tender
# Files: local (DATA_DIR) on the VM, gcs (GCS_BUCKET) on Cloud Run. Which product this
# process serves: enterprise (every route and the web) or api (the intelligence API).
STORAGE_BACKEND=local
GCS_BUCKET=
PRODUCT=enterprise
DATA_DIR=/data
TENANT_ID=ergplan
PUBLIC_BASE_URL=https://34.131.65.108
# Guards /admin/reliability and /api/v1/admin/*; empty closes them. Any long random string.
ADMIN_TOKEN=
# The tender folders with their manifests (the freshness check reads each tender's source
# page from them) and the days between two checks of the corpus against the agencies'
# pages; 0 turns the weekly job off.
TENDERS_ROOT=/work/tenders
FRESHNESS_INTERVAL_DAYS=7
# Sign-in (Stage 5C): the Google OIDC client registered for this deployment; its callback
# is <PUBLIC_BASE_URL>/api/v1/auth/callback. Only verified addresses of the allowed
# domains sign in (comma list; empty: any). A first sign-in makes a reviewer, or an admin
# for the bootstrap addresses. SESSION_SECRET signs the sign-in state; any long random
# string; empty refuses sign-in.
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ALLOWED_DOMAINS=
BOOTSTRAP_ADMIN_EMAILS=
SESSION_SECRET=
SESSION_HOURS=12
# The intelligence API's keys: calls per minute and per UTC day for a key made without
# its own limits.
API_KEY_RATE_LIMIT_PER_MIN=60
API_KEY_DAILY_CAP=5000
# The public library (Stage 5D): whether an address outside the allowed domains may sign
# up for a free account (its own tenant, reading the library only), and the score below
# which find_matching_tender answers no_match rather than a wrong match.
FREE_SIGNUP_ENABLED=true
MATCH_THRESHOLD=0.75
# Parsing layers (Stage 7, Block 2): the Docling service of the `parsing` compose profile,
# started by `make deploy` (the owner's decision of 2026-10-27: on, on the e2-medium);
# an empty DOCLING_URL turns the layer off.
COMPOSE_PROFILES=parsing
DOCLING_URL=http://docling:5001
DOCLING_TABLES=true
# Full-tender query (Stage 7, Block 5): retrieval chunks in the same database (pgvector);
# embeddings from a local ONNX model (fastembed; the files are kept under
# EMBEDDINGS_CACHE_DIR, downloaded once from Hugging Face) or none (full-text search
# alone). Haystack sends no usage telemetry from this deployment.
RETRIEVAL_ENABLED=true
EMBEDDINGS_PROVIDER=local
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDINGS_CACHE_DIR=/data/models/fastembed
# Webhooks (Stage 7, Block 6 b): receivers must be public addresses; true admits private
# and in-network hosts (a receiver on the same Docker network, such as TenderOS on this VM).
WEBHOOK_ALLOW_PRIVATE=false
HAYSTACK_TELEMETRY_ENABLED=False
# The independent reviewer (operating rule 15; owner's decision 2026-10-25: no OpenAI).
REVIEW_MODEL=claude-opus-5-5
